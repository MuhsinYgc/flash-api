# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/flah

# Auth — use a long random string (32+ chars). Required in production.
JWT_SECRET=replace-with-at-least-32-random-characters-please

# Public site URL (frontend). Used to infer cookie Secure flag.
SITE_URL=http://localhost:3200

# This API
API_URL=http://localhost:3201

# Optional override. Usually inferred from SITE_URL (http=false, https=true).
# SESSION_COOKIE_SECURE=false
